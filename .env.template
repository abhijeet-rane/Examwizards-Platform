# Copy this file to `.env` at the repository root (never commit `.env`).
# Values here are placeholders only.

# Database (Spring Boot / local JDBC)
DB_URL=jdbc:mysql://localhost:3306/examwizards
DB_USERNAME=examport
DB_PASSWORD=your-database-password

# Database (Docker Compose root password for MySQL service)
# DB_PASSWORD=root

# Email (Gmail SMTP)
EMAIL_USERNAME=your-email-address
EMAIL_PASSWORD=your-email-app-password
EMAIL_FROM=ExamWizards <noreply@examwizards.com>
EMAIL_ENABLED=true
EMAIL_ADMIN=your-email-address

# Razorpay
RAZORPAY_KEY_ID=razorpay-key-id
RAZORPAY_KEY_SECRET=razorpay-key-secret

# Google Gemini (chatbot / optional features)
GENAI_API_KEY=GenAI-api-key

# JWT (use a long random secret in production)
JWT_SECRET=your-jwt-secret-key-here

# Frontend build-time (Vite)
# VITE_API_BASE_URL=http://localhost:8080/api
