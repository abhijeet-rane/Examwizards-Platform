# Database Configuration (Spring Boot)
DB_URL=jdbc:mysql://localhost:3306/examwizards
DB_USERNAME=examport
DB_PASSWORD=your-database-password

# Docker Compose: MYSQL_ROOT_PASSWORD is also taken from DB_PASSWORD when set in .env

# Email Configuration (Gmail SMTP)
EMAIL_USERNAME=your-email-address
EMAIL_PASSWORD=your-email-app-password
EMAIL_FROM=ExamWizards <noreply@examwizards.com>
EMAIL_ENABLED=true
EMAIL_ADMIN=your-email-address

# Razorpay Payment Gateway Configuration
RAZORPAY_KEY_ID=razorpay-key-id
RAZORPAY_KEY_SECRET=razorpay-key-secret

# Google Gemini AI Configuration
GENAI_API_KEY=GenAI-api-key

# JWT Configuration
JWT_SECRET=your-jwt-secret-key-here
